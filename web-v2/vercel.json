{
  "version": 2,
  "functions": {
    "api/diagnostico.js": {
      "maxDuration": 40
    },
    "api/municipios.js": {
      "maxDuration": 30
    },
    "api/analise.js": {
      "maxDuration": 45
    },
    "api/relatorio.js": {
      "maxDuration": 45
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}